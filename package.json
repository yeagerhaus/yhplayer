{
	"name": "rite",
	"main": "expo-router/entry",
	"version": "0.1",
	"scripts": {
		"start": "tsx ./tools/run.ts",
		"start:quick": "SKIP_BUN_INSTALL=1 tsx ./tools/run.ts",
		"start:tunnel": "EXPO_METRO_HOST=tunnel SKIP_BUN_INSTALL=1 tsx ./tools/run.ts",
		"start:sim": "EXPO_METRO_HOST=localhost SKIP_BUN_INSTALL=1 bunx expo start --dev-client --host localhost",
		"web": "expo start --web",
		"prep": "bun install && npx pod-install",
		"kill": "lsof -ti:8081 | xargs kill -9",
		"clean": "rm -rf node_modules && rm -rf ios/Pods ios/Podfile.lock && rm -rf .expo",
		"up": "bun update; bunx expo@latest install --check",
		"b": "eas build --profile development --platform ios",
		"b:test": "npx expo run:ios --configuration Release --device",
		"check:tsc": "tsc --project tsconfig.json --noEmit",
		"check:biome": "biome check --formatter-enabled=true --linter-enabled=true --vcs-enabled=true --write --unsafe .",
		"check:all": "bun check:tsc && bun check:biome",
		"prepare": "husky && npx patch-package",
		"postinstall": "npx patch-package",
		"android": "expo run:android",
		"ios": "expo run:ios"
	},
	"dependencies": {
		"@expo/metro-runtime": "~57.0.3",
		"@react-native-community/slider": "5.2.0",
		"@react-navigation/native": "7.1.28",
		"@shopify/flash-list": "2.0.2",
		"dotenv": "^17.3.1",
		"expo": "^57.0.0",
		"expo-background-fetch": "~57.0.2",
		"expo-blur": "~57.0.0",
		"expo-constants": "~57.0.3",
		"expo-crypto": "~57.0.0",
		"expo-dev-client": "~57.0.5",
		"expo-device": "~57.0.0",
		"expo-file-system": "~57.0.0",
		"expo-font": "~57.0.0",
		"expo-glass-effect": "~57.0.0",
		"expo-haptics": "~57.0.0",
		"expo-image": "~57.0.0",
		"expo-linear-gradient": "~57.0.0",
		"expo-linking": "~57.0.1",
		"expo-network": "~57.0.0",
		"expo-notifications": "~57.0.3",
		"expo-router": "~57.0.3",
		"expo-splash-screen": "~57.0.2",
		"expo-status-bar": "~57.0.0",
		"expo-symbols": "~57.0.0",
		"expo-system-ui": "~57.0.0",
		"expo-task-manager": "~57.0.2",
		"expo-web-browser": "~57.0.0",
		"fast-xml-parser": "^5.3.7",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.0",
		"react-native-carplay": "^2.4.1-beta.0",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-get-random-values": "^1.11.0",
		"react-native-image-colors": "^2.5.1",
		"react-native-mmkv": "^4.3.0",
		"react-native-reanimated": "4.5.0",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "4.25.2",
		"react-native-web": "^0.21.2",
		"react-native-worklets": "0.10.0",
		"tsx": "^4.21.0",
		"yhwav-audio": "file:./modules/yhwav-audio",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "2.0.0",
		"@types/node": "^26.1.0",
		"@types/react": "~19.2.4",
		"baseline-browser-mapping": "^2.10.0",
		"husky": "^9.1.7",
		"typescript": "~6.0.3"
	},
	"expo": {},
	"private": true
}
